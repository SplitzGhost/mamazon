{
  "name": "mamazon",
  "private": true,
  "type": "module",
  "scripts": {
    "api": "wrangler dev --config worker/wrangler.toml --port 8787",
    "web": "http-server docs -p 8080 -c-1 --silent",
    "db:local": "wrangler d1 execute mamazon --local --config worker/wrangler.toml --file worker/schema.sql",
    "secrets:local": "node tools/secrets.mjs local",
    "secrets:live": "node tools/secrets.mjs live",
    "icons": "node tools/icons.mjs",
    "test": "node --test \"test/*.test.js\""
  },
  "devDependencies": {
    "http_ece": "^1.2.1",
    "http-server": "^14.1.1",
    "sharp": "^0.35.5",
    "wrangler": "^4.156.0"
  }
}
